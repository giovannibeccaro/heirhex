{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git push origin autonomo/:*)",
      "Bash(git push -u origin autonomo/:*)",
      "Bash(git clone:*)",
      "Bash(godot:*)",
      "Bash(/Applications/Godot.app/Contents/MacOS/Godot:*)",
      "Bash(python3:*)",
      "Bash(pip3 install --user:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(unzip:*)",
      "Bash(curl -L -o:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.godotengine.org)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
